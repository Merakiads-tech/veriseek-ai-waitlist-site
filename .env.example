# Example environment — copy to .env and fill in real values.
# Do NOT commit your real .env to git.

# Where the waitlist app itself is hosted (used by email template + Open Graph)
NEXT_PUBLIC_BASE_URL=https://waitlist.veriseek.ai

# Main marketing site URL (used by email CTA + thank-you page "Visit" link)
NEXT_PUBLIC_SITE_URL=https://veriseek.ai

# Supabase — public (safe in client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase — server-only secret (bypasses RLS for inserts from /api/waitlist/*)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend — server-only secret (sends the thank-you email)
RESEND_API_KEY=re_YOUR_RESEND_KEY
# From address (must be a verified domain in Resend)
RESEND_FROM_EMAIL=VeriSeek <no-reply@veriseek.ai>

# Template placeholders — unused by the waitlist app
MONGO_URL=mongodb://localhost:27017
DB_NAME=your_database_name
CORS_ORIGINS=*
