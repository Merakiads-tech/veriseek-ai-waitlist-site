# Example environment — copy to .env and fill in real values
# Do NOT commit your real .env to git.

# Public base URL where the app will be deployed
NEXT_PUBLIC_BASE_URL=https://waitlist.veriseek.ai

# Supabase — public (safe in client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase — server-only secret (used by /api/waitlist/* routes to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Mongo placeholders kept for template compatibility (not used by waitlist app)
MONGO_URL=mongodb://localhost:27017
DB_NAME=your_database_name
CORS_ORIGINS=*
